{
  "manifest_version": 3,
  "name": "YT Unleashed — Premium Feel",
  "version": "1.0.0",
  "description": "Full YouTube Premium experience: ad-free, background play, no upsell popups.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/adblock.js"],
      "css": ["content/styles.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YT Unleashed"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
